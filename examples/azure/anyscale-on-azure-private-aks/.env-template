# Copy to .env and edit.
# ARM_* controls Azure auth.
# TF_VAR_* becomes infra/terraform/terraform.auto.tfvars.json during deploy.

###############################################################################
# Azure operator context
###############################################################################
# Keep ARM_* and TF_VAR_azure_* aligned unless you intentionally split auth and target.
ARM_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
ARM_TENANT_ID="00000000-0000-0000-0000-000000000000"
ARM_USE_CLI="true"

# Optional non-interactive Azure auth. Do not commit secrets.
# ARM_CLIENT_ID="00000000-0000-0000-0000-000000000000"
# ARM_CLIENT_SECRET=""
# ARM_USE_OIDC="true"
# ARM_USE_MSI="true"

TF_VAR_azure_subscription_id="00000000-0000-0000-0000-000000000000"
TF_VAR_azure_tenant_id="00000000-0000-0000-0000-000000000000"
SSH_PRIVATE_KEY_PATH="${HOME:-/home/${USER:-azureoperator}}/.ssh/id_ed25519"

# Optional: set to a reachable repo URL (for example a public fork) to have the
# jump-host bootstrap git-clone the repo instead of waiting for 'module 2 sync'.
# You still run 'module 2 sync' once to place the gitignored .env on the VM.
# See docs/modules/module-2-jump-hosts.md for the trade-offs.
# ANYSCALE_AKS_REPO_URL="https://github.com/<your-org>/<your-fork>"

###############################################################################
# Deployment naming and tags
###############################################################################
TF_VAR_project="myproject"
TF_VAR_environment="dev"
TF_VAR_azure_location="westus3"
TF_VAR_region_short="wus3"
TF_VAR_tags='{"Project":"myproject","Environment":"dev","ManagedBy":"terraform","Owner":"change-me"}'

###############################################################################
# Anyscale CLI and cloud metadata
###############################################################################
# Local interactive login:
#   ANYSCALE_HOST=https://console.azure.anyscale.com .venv/bin/anyscale login
# Leave cloud name and deployment ID blank on the first deploy; the harness backfills them.
# Use ANYSCALE_CLI_TOKEN only for non-interactive or in-pod CLI flows.
ANYSCALE_HOST="https://console.azure.anyscale.com"
ANYSCALE_BROWSER_AUTH_HOST="https://console.anyscale.com"
ANYSCALE_CLOUD_NAME=""
ANYSCALE_CLOUD_DEPLOYMENT_ID=""
ANYSCALE_CLI_TOKEN=""

###############################################################################
# Optional custom image proof
###############################################################################
# Local podman mode builds on the in-VNet Linux jump host, which already reaches
# the private ACR and storage endpoints through private DNS.
# Current harness path: podman. Other values are reserved for future modes.
ANYSCALE_CUSTOM_IMAGE_ENABLED="false"
ANYSCALE_CUSTOM_IMAGE_REPOSITORY="anyscale/proof-custom"
ANYSCALE_CUSTOM_IMAGE_TAG="onnxruntime-1.22.0-ray-2.55.1-py312-cu129"
ANYSCALE_CUSTOM_IMAGE_RAY_VERSION="2.55.1"
ANYSCALE_CUSTOM_IMAGE_REQUIREMENT="onnxruntime==1.22.0"
ANYSCALE_CUSTOM_IMAGE_BUILD_MODE="podman"
ANYSCALE_CUSTOM_IMAGE_URI=""

###############################################################################
# Network layout
###############################################################################
# Required: the VNet and subnet layout must match your address plan.
TF_VAR_vnet_address_space='["10.50.0.0/16"]'
TF_VAR_subnet_cidrs='{"firewall":"10.50.0.0/26","bastion":"10.50.0.128/26","aks_apiserver":"10.50.1.0/28","dns_resolver_in":"10.50.1.16/28","dns_resolver_out":"10.50.1.32/28","private_endpoints":"10.50.2.0/24","jump_host":"10.50.3.0/27","browser_jump_host":"10.50.3.32/27","aks_nodes":"10.50.4.0/22"}'

# Kubernetes service CIDR and DNS IP. Defaults: 10.100.0.0/16 and 10.100.0.10.
# Override both together; dns_service_ip must sit inside service_cidr.
# TF_VAR_service_cidr="10.100.0.0/16"
# TF_VAR_dns_service_ip="10.100.0.10"

###############################################################################
# Foundation jump hosts
###############################################################################
# Leave the SSH key empty to have the harness read
# "${SSH_PRIVATE_KEY_PATH}.pub" from the workstation.
TF_VAR_linux_jump_host_admin_ssh_public_key=""

# 'module 1 sizes' writes linux_jump_host_vm_size here after checking regional
# availability. Defaults: Standard_D4s_v5 / azureoperator.
# TF_VAR_linux_jump_host_vm_size="Standard_D4s_v5"
# TF_VAR_linux_jump_host_admin_username="azureoperator"

# Optional Windows browser jump host. Default: disabled. A local admin password
# is required by Azure when you enable it.
# TF_VAR_enable_browser_host="true"
# TF_VAR_windows_browser_jump_host_admin_password=""
# TF_VAR_windows_browser_jump_host_vm_size="Standard_D4s_v5"
# TF_VAR_windows_browser_jump_host_admin_username="azureadmin"
# TF_VAR_browser_host_vm_user_login_principal_ids='{}'
# TF_VAR_browser_host_vm_admin_login_principal_ids='{}'

# Jump-host managed identity roles. Contributor is required (bootstrap runs
# 'az login --identity' on the VM). Defaults: true / false / "" (subscription).
# TF_VAR_assign_jump_host_subscription_contributor="true"
#
# RBAC Administrator is needed ONLY when the VM itself runs Terraform, which is
# an advanced setup. Leave false for the documented workflow
# (Terraform from the workstation, jump host as a network-adjacent runner).
# Setting it true lets the VM's identity assign roles at this scope, including
# roles you cannot assign yourself. See infra/terraform/variables.tf.
TF_VAR_assign_jump_host_rbac_admin="false"
# TF_VAR_jump_host_rbac_scope=""

# Optional conditional forwarders for Azure DNS Private Resolver. Default: {}
# TF_VAR_dns_forwarding_rules='{"corp-contoso":{"domain_name":"corp.contoso.com.","target_dns_servers":[{"ip_address":"10.10.10.10","port":53}]}}'

###############################################################################
# Firewall allow-lists
###############################################################################
# All four allow-lists default to the reviewed repo lists in
# infra/terraform/variables.tf. Set one here only to add or remove entries; an
# assignment replaces the whole list rather than appending to it.
#
# Not a typo: the anyscale_fqdns default contains westus2 entries
# (*.az1.westus2.admin.azure.anyscale.com, anyscaleazwestus2prod.blob/dfs...).
# Those are Anyscale *control plane* endpoints, which live in westus2 regardless
# of the region you deploy into. They are unrelated to TF_VAR_azure_location.
#
# TF_VAR_anyscale_fqdns='[...]'
# TF_VAR_azure_identity_fqdns='[...]'
# TF_VAR_azure_monitor_fqdns='[...]'
# TF_VAR_container_registry_fqdns='[...]'
# TF_VAR_tool_bootstrap_fqdns='[...]'   # jump-host toolchain egress (apt, PyPI)

###############################################################################
# Platform RBAC and operator identity
###############################################################################
# Platform admin for the deploying principal at subscription scope is the
# Terraform default. Set this only to disable it or change the role/scope.
# TF_VAR_anyscale_platform_default_admin_assignment='{"enabled":false}'

# Prefer this map for extra platform access. Default: {}
# TF_VAR_anyscale_platform_role_assignments='{"data-science-team":{"principal_id":"00000000-0000-0000-0000-000000000000","principal_type":"Group","role_definition_name":"Anyscale Platform Contributor","scope":"cloud"}}'

# Legacy compatibility only. Default: {}
# TF_VAR_anyscale_platform_admin_role_assignments='{}'

# Optional extension pin for rollback testing.
# TF_VAR_anyscale_platform='{"extension_version":"1.5.1"}'

# Operator namespace/service account default to "anyscale-operator". The AKS
# extension's gateway config and TLS secret naming assume it; change both
# together or not at all.
# TF_VAR_anyscale_operator_namespace="anyscale-operator"
# TF_VAR_anyscale_operator_serviceaccount="anyscale-operator"

# mode: create | existing-managed-rbac | existing-external-rbac. Default: create
# TF_VAR_anyscale_operator_identity='{"mode":"create"}'

###############################################################################
# AKS sizing
###############################################################################
# Required: no default, because both are region- and quota-sensitive.
TF_VAR_system_vm_size="Standard_D2s_v5"
TF_VAR_cpu_vm_size="Standard_D16s_v5"

# Required. min_count 1 keeps one T4 warm so the first GPU proof does not wait
# on scale-from-zero. Sized for a 32 vCPU NCASv3_T4 quota (max 2 nodes).
#
# No T4 quota? Set this to '{}' for a CPU-only deploy. 'init' does that for you
# when it finds no quota in the target region. Everything else still deploys and
# still proves out — private AKS, firewall egress, private storage and ACR,
# Gateway and TLS, the CPU proof, the build job. Only the GPU node pool, the
# NVIDIA device plugin, the aks-gpu compute config and workspace, and the GPU,
# train, and serve proofs are skipped, and each surface says so.
TF_VAR_gpu_pool_configs='{"T4":{"name":"gput4","vm_size":"Standard_NC16as_T4_v3","product_name":"NVIDIA-T4","gpu_count":"1","min_count":1,"max_count":2,"availability_zones":[]}}'

# Pin an exact patch version for reproducible node bootstrap. Default: null
# (regional default). The validated baseline is 1.34.6.
TF_VAR_kubernetes_version='"1.34.6"'

# Defaults: ["1","2","3"] / Standard / 3 / 6
# TF_VAR_availability_zones='["1","2","3"]'
# TF_VAR_aks_sku_tier="Standard"
# TF_VAR_system_node_pool_min_count="3"
# TF_VAR_system_node_pool_max_count="6"

###############################################################################
# Storage and registry
###############################################################################
# Defaults: the Anyscale-required CORS rule, ZRS, and zone-redundant ACR.
# TF_VAR_storage_cors_rule='{...}'
# TF_VAR_storage_replication_type="ZRS"
# TF_VAR_acr_zone_redundancy_enabled="true"

# Mirror upstream images (registry.k8s.io, Docker Hub, quay.io, ...) into the
# private ACR. Only needed when a workload pulls an image the ACR doesn't
# already carry and firewall egress to that registry is locked down. Default: {}
# TF_VAR_acr_cache_rules='{"k8s_pause":{"source_repo":"registry.k8s.io/pause","target_repo":"k8s-cache/pause"}}'

###############################################################################
# Private Link to the Anyscale control plane (optional)
###############################################################################
# Off by default: the firewall's anyscale_fqdns allow-list already covers
# outbound control-plane traffic over the public internet. Turn this on only
# when the environment requires the SaaS control plane to be reachable without
# ever leaving the VNet.
#
# Ask your Anyscale contact for the Private Link Service alias and the
# private DNS zone name before enabling this — both are specific to your
# cloud deployment, not values you can invent. The alias looks like
# "epr-0-production-pls.<guid>.<region>.azure.privatelinkservice"; the zone
# name is the domain your Anyscale control-plane hostnames live under.
#
# Turning this on does not finish the connection by itself: Anyscale owns the
# Private Link Service and must approve the connection request on their side.
# `terraform apply` succeeds with the endpoint left in a Pending state --
# a green apply is not proof the path works yet. After apply, run
# `./scripts/setup.sh privatelink-status` to check the connection state and
# confirm DNS resolves to the private endpoint's IP from inside the cluster.
#
# TF_VAR_enable_anyscale_privatelink="true"
# TF_VAR_anyscale_privatelink_service_alias="epr-0-production-pls.00000000-0000-0000-0000-000000000000.westus2.azure.privatelinkservice"
# TF_VAR_anyscale_privatelink_dns_zone_name="azure.anyscale-cloud.dev"
# TF_VAR_anyscale_privatelink_record_names='["*"]'

###############################################################################
# Observability
###############################################################################
# All observability inputs default to the private-ingestion posture in
# infra/terraform/variables.tf: 30-day retention, private-only AMPLS ingestion,
# open query, ContainerLogV2, and Terraform-managed diagnostic settings.
# TF_VAR_log_analytics_retention_days="30"
# TF_VAR_log_analytics_internet_ingestion_enabled="false"
# TF_VAR_log_analytics_internet_query_enabled="true"
# TF_VAR_ampls_enabled="true"
# TF_VAR_ampls_ingestion_access_mode="PrivateOnly"
# TF_VAR_ampls_query_access_mode="Open"
# TF_VAR_container_insights_v2_enabled="true"
# TF_VAR_container_insights_streams='["Microsoft-ContainerLogV2","Microsoft-KubeEvents","Microsoft-KubePodInventory"]'
# TF_VAR_container_insights_data_collection_interval="1m"
# TF_VAR_container_insights_namespace_filtering_mode="Off"
# TF_VAR_container_insights_namespaces='[]'
# TF_VAR_terraform_managed_diagnostic_settings_enabled="true"
