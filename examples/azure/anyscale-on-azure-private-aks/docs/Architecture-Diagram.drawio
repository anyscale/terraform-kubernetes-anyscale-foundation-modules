<mxfile host="app.diagrams.net" modified="2026-06-11T00:00:00.000Z" agent="GitHub Copilot" version="24.7.17" type="device">
  <diagram id="private-aks-reference" name="High Level Flow">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
